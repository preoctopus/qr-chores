# QR Chores nginx reverse proxy
# Generated from this template by scripts/entrypoint.sh (envsubst).
#
# Performance notes:
# - Static marketing + /static/ are served from NGINX_*_ROOT (tmpfs/RAM when available)
# - open_file_cache keeps open FDs + metadata hot (effective RAM-backed static serving)
# - gzip for text assets; sendfile/tcp_nopush for efficient disk/tmpfs I/O
# - keepalive to FastAPI and MCP upstreams

worker_processes auto;
worker_rlimit_nofile 4096;
error_log ${NGINX_ERROR_LOG_PRIMARY};
${NGINX_ERROR_LOG_SECONDARY}
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time urt=$upstream_response_time';

    access_log ${NGINX_ACCESS_LOG_PRIMARY};
    ${NGINX_ACCESS_LOG_SECONDARY}

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 1000;
    types_hash_max_size 2048;
    server_tokens off;
    client_max_body_size 10M;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 30s;

    # Keep frequently-served static files open in the worker (FD + metadata cache).
    # Combined with tmpfs roots this approximates in-memory static serving.
    open_file_cache max=2000 inactive=120s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    # Compression (skip already-compressed images/video)
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml
        font/woff2;

    # FastAPI application
    upstream app_upstream {
        server 127.0.0.1:8000;
        keepalive 32;
    }

    # FastMCP streamable HTTP (long-lived SSE streams)
    upstream mcp_upstream {
        server 127.0.0.1:${MCP_PORT};
        keepalive 8;
    }

    server {
        listen ${PORT};
        server_name _;

        root ${NGINX_MARKETING_ROOT};
        index index.html;

        # ---- Static marketing site (RAM/tmpfs when available) ----
        location / {
            try_files $uri $uri/ @fastapi;
        }

        location = /index.html {
            expires 1h;
            add_header Cache-Control "public";
        }

        location = /guide.html {
            expires 1h;
            add_header Cache-Control "public";
        }

        location = /styles.css {
            expires 7d;
            add_header Cache-Control "public";
            access_log off;
        }

        location = /script.js {
            expires 7d;
            add_header Cache-Control "public";
            access_log off;
        }

        location /assets/ {
            alias ${NGINX_MARKETING_ROOT}/assets/;
            expires 30d;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # ---- App static (CSS/JS/icons) — bypass FastAPI ----
        location /static/ {
            alias ${NGINX_APP_STATIC_ROOT}/;
            expires 7d;
            add_header Cache-Control "public";
            access_log off;
        }

        # ---- QR scan links ----
        location /c/ {
            proxy_pass http://app_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }

        # ---- Internal JSON API ----
        location /api/ {
            proxy_pass http://app_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
            client_max_body_size 10M;
        }

        # ---- FastMCP streamable HTTP & OAuth 2.1 endpoints (/mcp/*) ----
        location /mcp {
            proxy_pass http://mcp_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            # SSE / streamable-http: no buffering, long timeouts
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            chunked_transfer_encoding on;
        }

        # ---- OAuth 2.1 RFC 8414 / RFC 9728 discovery ----
        location /.well-known/ {
            proxy_pass http://mcp_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }

        # ---- Health (prefer fast path; no access log noise) ----
        location ~ ^/(healthz|health)(/.*)?$ {
            proxy_pass http://app_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
            access_log off;
        }

        # ---- FastAPI fallback (HTML app routes) ----
        location @fastapi {
            proxy_pass http://app_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }
}
