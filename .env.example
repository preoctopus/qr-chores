# ==============================================================================
# QR Chores - Environment Configuration Example
# Copy this file to `.env` for local development.
#
# Sources of truth:
#   - App settings:     src/qr_chores/config.py (pydantic Settings)
#   - Server bind:      src/qr_chores/main.py (PORT)
#   - Docker entrypoint: scripts/entrypoint.sh (RUN_*, MCP_*)
#   - FastMCP (client): clients/python (QR_CHORES_*, MCP_*)
#
# CLI-only client vars (qrc): QRC_BASE_URL, QRC_TOKEN, QRC_CONFIG_DIR —
# see clients/python/README.md (not required for the server).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Setup
# ------------------------------------------------------------------------------

# Application display name used in page titles and headers.
# Type: string | Default: "QR Chores"
APP_NAME="QR Chores"

# Runtime environment mode: "development" or "production".
# Setting to "production" disables OpenAPI interactive docs (/docs).
# Type: string ("development" | "production") | Default: "development"
ENVIRONMENT=development

# Cryptographic key for signing session cookies and API bearer tokens
# (itsdangerous URLSafeTimedSerializer — opaque signed values, not JWTs).
# MUST be set to a strong random value when ENVIRONMENT=production,
# when BASE_URL uses HTTPS, or when DATABASE_URL uses Postgres.
# Do NOT reuse this as ADMIN_API_KEY.
# Type: string | Default: "dev-only-change-me"
SECRET_KEY=dev-only-change-me

# Optional fallback public base URL. The app dynamically derives base URLs
# from request headers (Host, X-Forwarded-Host, X-Forwarded-Proto).
# Type: string (URL) | Default: "http://127.0.0.1:8765"
BASE_URL=http://127.0.0.1:8765

# HTTP port the application server binds to.
# Local `uv run` default is 8765; Docker/Cloud Run entrypoint defaults to 8080.
# Type: integer | Default: 8765 (local) / 8080 (container)
PORT=8765

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------

# SQLAlchemy async database connection string.
# Dev:  "sqlite+aiosqlite:///./data/qr_chores.db"
# Prod: "postgresql+asyncpg://user:pass@host:5432/dbname"
# Type: string (DSN) | Default: "sqlite+aiosqlite:///./data/qr_chores.db"
DATABASE_URL=sqlite+aiosqlite:///./data/qr_chores.db

# ------------------------------------------------------------------------------
# 3. Session & Authentication
# ------------------------------------------------------------------------------

# Name of the HTTP-only cookie used for browser session authentication.
# Type: string | Default: "qr_chores_session"
SESSION_COOKIE_NAME=qr_chores_session

# Expiration for session cookies and API bearer tokens (seconds).
# Type: integer (seconds) | Default: 1209600 (14 days)
SESSION_MAX_AGE_SECONDS=1209600

# ------------------------------------------------------------------------------
# 4. Admin bootstrap registration (internal)
# ------------------------------------------------------------------------------

# Shared secret for POST /api/v1/admin/users (header: X-Admin-Key).
# Used to bootstrap parent (or other) accounts — not family-facing signup.
# Empty/unset disables the admin route (503 "Admin API is not configured").
# Must be a dedicated secret — do NOT set this to SECRET_KEY.
# Type: string | Default: "" (disabled)
# ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 5. Timezone & Chore Timing Rules
# ------------------------------------------------------------------------------

# IANA timezone key used for local day boundaries and due times.
# Type: string (TZ identifier) | Default: "America/Chicago"
APP_TIMEZONE=America/Chicago

# Grace period in minutes after due time where completions are still on-time.
# Type: integer (minutes) | Default: 15
ON_TIME_GRACE_MINUTES=15

# Window in minutes before due time required to earn early completion bonuses.
# Type: integer (minutes) | Default: 60
EARLY_WINDOW_MINUTES=60

# ------------------------------------------------------------------------------
# 6. Proof Photo Storage
# ------------------------------------------------------------------------------

# Photo storage backend: "local" (disk in dev) or "gcs" (Google Cloud Storage in prod).
# Type: string ("local" | "gcs") | Default: "local"
PHOTO_STORAGE=local

# Local path (relative or absolute) to store photo uploads when PHOTO_STORAGE=local.
# Type: string (path) | Default: "./data/uploads"
PHOTO_LOCAL_DIR=./data/uploads

# Name of GCS bucket for photos when PHOTO_STORAGE=gcs (required with GCS).
# Type: string | Default: ""
# GCS_BUCKET=my-qr-chores-photos-bucket

# Maximum allowed file size for proof photo uploads (in bytes).
# Type: integer (bytes) | Default: 5242880 (5 MB)
PHOTO_MAX_BYTES=5242880

# How long to keep proof photo *blobs* (calendar days by completion local_date).
# After this age, `qr-chores-reap-photos` deletes the object and clears
# photo_object_key (completion history + had_photo stats remain).
# Set to 0 to disable reaping. Type: integer (days) | Default: 90
# PHOTO_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 7. Database Seeding Defaults
# ------------------------------------------------------------------------------

# Default password set for seed parent accounts when running `qr-chores-seed`.
# Type: string | Default: "parent-pass"
SEED_PARENT_PASSWORD=parent-pass

# Default password set for seed child account when running `qr-chores-seed`.
# Type: string | Default: "child-pass"
SEED_CHILD_PASSWORD=child-pass

# ------------------------------------------------------------------------------
# 8. Logging (app + nginx + MCP)
# ------------------------------------------------------------------------------

# Python log level for the FastAPI app and MCP server.
# Type: string (DEBUG | INFO | WARNING | ERROR) | Default: INFO
# LOG_LEVEL=INFO

# Optional rsyslog / syslogd destination. When set, nginx, the QR Chores app,
# and the MCP server dual-write logs to this host (UDP) in addition to
# stdout/stderr (container platforms). Leave unset for console-only.
# Format: host  or  host:port  (default port 514). Optional scheme: udp://host:514
# Type: string | Default: "" (disabled)
# SYSLOG_SERVER=
# SYSLOG_SERVER=rsyslog.internal:514

# ------------------------------------------------------------------------------
# 9. Container & Deployment Entrypoint Flags
# ------------------------------------------------------------------------------

# Set to 1 in Docker/Cloud Run entrypoint to run `alembic upgrade head` on start.
# Type: integer (0 | 1) | Default: 0
# RUN_MIGRATIONS=0

# Set to 1 in Docker/Cloud Run entrypoint to run `qr-chores-seed` on start.
# Type: integer (0 | 1) | Default: 0
# RUN_SEED=0

# ------------------------------------------------------------------------------
# 10. FastMCP (Docker / co-located MCP server)
# ------------------------------------------------------------------------------
# Used by scripts/entrypoint.sh and clients/python FastMCP. Optional for plain
# local `uv run` of the web app only.

# Transport: "stdio" (local CLI default), "http", "streamable-http", or "sse".
# Docker entrypoint defaults to "http".
# Type: string | Default: stdio (MCP process) / http (Docker entrypoint)
# MCP_TRANSPORT=http

# HTTP bind host for the MCP server process (behind nginx in Docker).
# Type: string | Default: 127.0.0.1
# MCP_HOST=127.0.0.1

# HTTP bind port for the MCP server (nginx proxies public /mcp → this port).
# Type: integer | Default: 8001
# MCP_PORT=8001

# URL path for streamable HTTP MCP.
# Type: string | Default: /mcp
# MCP_PATH=/mcp

# Stateless streamable HTTP (recommended behind proxies). "1" = on, "0" = off.
# Type: string (0 | 1) | Default: 1 (Docker entrypoint)
# MCP_STATELESS_HTTP=1

# Enable OAuth 2.1 authentication on FastMCP HTTP server for ChatGPT. "1" = on, "0" = off.
# Type: string (0 | 1) | Default: 1 (when HTTP transport is used)
# MCP_OAUTH_ENABLED=1

# Public base URL for OAuth 2.1 issuer / discovery (defaults to BASE_URL or http://127.0.0.1:8001).
# Type: string (URL) | Default: unset
# MCP_PUBLIC_URL=https://qr-chores.example.com

# API origin the MCP tools call. Optional; HTTP MCP defaults to
# http://127.0.0.1:8000 (in-container app), stdio defaults to :8765.
# Type: string (URL) | Default: (transport-dependent)
# QR_CHORES_BASE_URL=http://127.0.0.1:8765

# Optional auto-login for MCP tools (parent or child account).
# Type: string | Default: unset (call login tool manually)
# QR_CHORES_EMAIL=parent@example.com
# QR_CHORES_PASSWORD=parent-pass

# ------------------------------------------------------------------------------
# 11. Email Notifications (SMTP)
# ------------------------------------------------------------------------------
# Optional SMTP server configuration for email notifications (e.g. child notes).
# If SMTP_HOST is empty, emails are logged / captured in test outbox without error.

# SMTP host server address.
# Type: string | Default: "" (disabled)
# SMTP_HOST=smtp.example.com

# SMTP port.
# Type: integer | Default: 587
# SMTP_PORT=587

# SMTP username and password for authentication.
# Type: string | Default: ""
# SMTP_USER=
# SMTP_PASSWORD=

# Default "From" email address.
# Type: string | Default: "noreply@qrchores.com"
# SMTP_FROM_EMAIL=noreply@qrchores.com

# Enable TLS / STARTTLS for SMTP connections.
# Type: boolean (0 | 1 | true | false) | Default: true
# SMTP_USE_TLS=true

