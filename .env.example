# ==============================================================================
# QR Chores - Environment Configuration Example
# Copy this file to `.env` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Setup
# ------------------------------------------------------------------------------

# Application display name used in page titles and headers.
# Type: string | Default: "QR Chores"
APP_NAME="QR Chores"

# Runtime environment mode: "development" or "production".
# Setting to "production" disables OpenAPI interactive docs (/docs).
# Type: string ("development" | "production") | Default: "development"
ENVIRONMENT=development

# Cryptographic key for signing session cookies & API bearer tokens.
# MUST be set to a strong random value when ENVIRONMENT=production,
# when BASE_URL uses HTTPS, or when DATABASE_URL uses Postgres.
# Type: string | Default: "dev-only-change-me"
SECRET_KEY=dev-only-change-me

# Canonical public base URL encoded into generated QR code images.
# Must remain stable once QR code stickers are printed.
# Type: string (URL) | Default: "http://127.0.0.1:8765"
BASE_URL=http://127.0.0.1:8765

# HTTP port the application server binds to.
# Type: integer | Default: 8765 locally (8080 in Docker / Cloud Run)
PORT=8765

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------

# SQLAlchemy async database connection string.
# Dev:  "sqlite+aiosqlite:///./data/qr_chores.db"
# Prod: "postgresql+asyncpg://user:pass@host:5432/dbname"
# Type: string (DSN) | Default: "sqlite+aiosqlite:///./data/qr_chores.db"
DATABASE_URL=sqlite+aiosqlite:///./data/qr_chores.db

# ------------------------------------------------------------------------------
# 3. Session & Authentication
# ------------------------------------------------------------------------------

# Name of the HTTP-only cookie used for browser session authentication.
# Type: string | Default: "qr_chores_session"
SESSION_COOKIE_NAME=qr_chores_session

# Expiration time for authenticated session cookies (in seconds).
# Type: integer (seconds) | Default: 1209600 (14 days)
SESSION_MAX_AGE_SECONDS=1209600

# ------------------------------------------------------------------------------
# 4. Timezone & Chore Timing Rules
# ------------------------------------------------------------------------------

# IANA timezone key used for local day boundaries and due times.
# Type: string (TZ identifier) | Default: "America/Chicago"
APP_TIMEZONE=America/Chicago

# Grace period in minutes after due time where completions are still on-time.
# Type: integer (minutes) | Default: 15
ON_TIME_GRACE_MINUTES=15

# Window in minutes before due time required to earn early completion bonuses.
# Type: integer (minutes) | Default: 60
EARLY_WINDOW_MINUTES=60

# ------------------------------------------------------------------------------
# 5. Proof Photo Storage
# ------------------------------------------------------------------------------

# Photo storage backend: "local" (disk in dev) or "gcs" (Google Cloud Storage in prod).
# Type: string ("local" | "gcs") | Default: "local"
PHOTO_STORAGE=local

# Local path (relative or absolute) to store photo uploads when PHOTO_STORAGE=local.
# Type: string (path) | Default: "./data/uploads"
PHOTO_LOCAL_DIR=./data/uploads

# Name of GCS bucket for photos when PHOTO_STORAGE=gcs (Required in production with GCS).
# Type: string | Default: ""
# GCS_BUCKET=my-qr-chores-photos-bucket

# Maximum allowed file size for proof photo uploads (in bytes).
# Type: integer (bytes) | Default: 5242880 (5 MB)
PHOTO_MAX_BYTES=5242880

# ------------------------------------------------------------------------------
# 6. Database Seeding Defaults
# ------------------------------------------------------------------------------

# Default password set for seed parent accounts when running `qr-chores-seed`.
# Type: string | Default: "parent-pass"
SEED_PARENT_PASSWORD=parent-pass

# Default password set for seed child account when running `qr-chores-seed`.
# Type: string | Default: "child-pass"
SEED_CHILD_PASSWORD=child-pass

# ------------------------------------------------------------------------------
# 7. Container & Deployment Entrypoint Flags
# ------------------------------------------------------------------------------

# Set to 1 in Docker/Cloud Run entrypoint to run `alembic upgrade head` on container start.
# Type: integer (0 | 1) | Default: 0
# RUN_MIGRATIONS=0

# Set to 1 in Docker/Cloud Run entrypoint to run `qr-chores-seed` on container start.
# Type: integer (0 | 1) | Default: 0
# RUN_SEED=0

