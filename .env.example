# Copy to .env for local development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./data/qr_chores.db
APP_TIMEZONE=America/Chicago
BASE_URL=http://127.0.0.1:8765
# Optional seed passwords (used by qr-chores-seed)
SEED_PARENT_PASSWORD=parent-pass
SEED_CHILD_PASSWORD=child-pass
# Photos: local (dev) or gcs (Cloud Run)
PHOTO_STORAGE=local
PHOTO_LOCAL_DIR=./data/uploads
# GCS_BUCKET=your-bucket-name
# PHOTO_MAX_BYTES=5242880
